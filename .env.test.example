# Copy to .env.test (gitignored). Use a LOCAL Supabase instance:
#   brew install supabase/tap/supabase && supabase start
# then paste the values from `supabase status`.
TEST_SUPABASE_URL=http://127.0.0.1:54321
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=

# Only for a dedicated, throwaway hosted test project. Never your real project:
# cleanup deletes rows.
# ALLOW_REMOTE_TEST_DB=true
